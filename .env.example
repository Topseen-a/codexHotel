# Copy this file to .env and fill in real values for local development.
# .env is git-ignored — never commit real secrets.
# In production (Render, etc.) these are set as real environment variables
# in the host's dashboard instead of via this file.

MONGODB_URI=mongodb://localhost:27017/codexhotel
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# Bootstrap admin account, created once on first startup if no ADMIN exists yet.
# Change the password after first login.
ADMIN_EMAIL=admin@codexhotel.com
ADMIN_PASSWORD=ChangeMe123!
